# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# Experiment outputs: regenerated by the scripts in experiments/, never edited
# by hand, and too large/churny to version.  The uv.lock + the driver script +
# its seed are what make a figure reproducible, not the artefact itself.
# NB: `results/*` not `results/` -- git cannot re-include a file with `!` if its
# parent directory is itself excluded, so the trailing-slash form would swallow
# the .gitkeep below.
results/*
!results/.gitkeep

# Datasets are downloaded or generated, not versioned.
data/*
!data/.gitkeep

# Reference material: the tarball is a published preprint, re-downloadable from
# arXiv, so it stays out of history (10 MB).
arXiv-*.tar.gz
paper/

# Editors / OS
.vscode/
.idea/
*.swp
.DS_Store

# Notebooks
.ipynb_checkpoints/

# Implementation guide: kept local, not shipped in the public repo.
docs/
